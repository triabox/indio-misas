# ====== Base de datos ======
# Prod: Postgres (servicio en Easypanel). Dev: dejar vacío -> usa pglite embebido.
DATABASE_URL=postgres://usuario:password@host:5432/misas

# ====== Auth (Better Auth) ======
# Secreto largo y aleatorio (ej: openssl rand -hex 32)
BETTER_AUTH_SECRET=cambiar-por-un-secreto-largo-aleatorio
# La URL pública de la app (sin barra final)
BETTER_AUTH_URL=https://misas.tu-dominio

# ====== Google OAuth (opcional) ======
# Redirect URI a registrar: https://misas.tu-dominio/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ====== Cloudflare R2 (fotos) ======
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=misas
# Dominio público (Cloudflare) desde donde se sirven las imágenes
PUBLIC_R2_URL=https://fotos.tu-dominio

# ====== Server ======
HOST=0.0.0.0
PORT=3000
