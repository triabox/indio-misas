---
import Base from '@/layouts/Base.astro';
import Mosaico from '@/components/Mosaico.tsx';
import Panoramica from '@/components/Panoramica.tsx';
import MuroHistorias from '@/components/MuroHistorias.tsx';
import ContadorAlmas from '@/components/ContadorAlmas.tsx';
import SubirModal from '@/components/SubirModal.tsx';
import Compartir from '@/components/Compartir.tsx';
import { getEventoConPosts } from '@/lib/eventos.server';
import { TIPO_LABEL, formatNumero } from '@/lib/format';
import { resolveImagen } from '@/lib/resolveImagen';

const { slug } = Astro.params;
const data = await getEventoConPosts(slug!);
if (!data) {
  return new Response(null, { status: 404, statusText: 'Misa no encontrada' });
}
const { evento, fotos } = data;
const imagenObjetivo = resolveImagen(evento.slug, evento.imagenObjetivo);

// Foto real (absoluta) para la tarjeta de redes y la imagen de historia.
// Si el evento no tiene imagen propia, dejamos undefined → Base usa el OG por defecto.
const ogImagen = imagenObjetivo
  ? imagenObjetivo.startsWith('http')
    ? imagenObjetivo
    : new URL(imagenObjetivo, Astro.url.origin).href
  : undefined;
const ogDescripcion = `${formatNumero(evento.almas)} almas estuvieron en ${evento.titulo} · ${evento.lugar}, ${evento.ciudad}. Sumá la tuya al archivo del Indio.`;
---

<Base
  title={`${evento.titulo} — MISAS`}
  description={ogDescripcion}
  image={ogImagen}
  ogType="article"
>
  <!-- back -->
  <div class="mx-auto max-w-5xl px-5 pt-6">
    <a href="/" class="cond text-xs uppercase tracking-ancho text-hueso-2/60 transition-colors hover:text-sangre-viva">
      ← Todas las misas
    </a>
  </div>

  <!-- ===================== HERO + MOSAICO ===================== -->
  <section class="mx-auto max-w-5xl px-5 pt-6 text-center">
    <span class="sello inline-block px-3 py-1 text-xs text-amarillo-luz">{TIPO_LABEL[evento.tipo]}</span>
    <h1 class="stencil mt-4 text-5xl leading-none text-hueso sm:text-7xl">{evento.titulo}</h1>
    <p class="cond mt-2 text-base text-amarillo-luz/90 sm:text-lg">{evento.subtitulo}</p>
    <p class="cond mt-1 text-xs uppercase tracking-ancho text-hueso-2/70">
      {evento.lugar} · {evento.ciudad} · {evento.fecha}
    </p>

    <div class="mt-8">
      <ContadorAlmas
        client:load
        valor={evento.almas}
        slug={evento.slug}
        fotos={fotos}
        label="almas que estuvieron"
        size="lg"
      />
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <Mosaico
        client:load
        slug={evento.slug}
        imagenObjetivo={imagenObjetivo}
        meta={evento.meta}
        reveladas={evento.reveladas}
        fotos={fotos}
        almas={evento.almas}
      />
    </div>
  </section>

  <!-- ===================== PANORÁMICA ===================== -->
  <section class="mx-auto max-w-5xl px-5 py-16">
    <h2 class="stencil text-3xl text-hueso sm:text-4xl">ENCONTRATE EN LA MULTITUD</h2>
    <p class="cond mt-1 mb-5 text-xs uppercase tracking-ancho text-hueso-2/60">
      Hacé zoom, arrastrá y tocá los puntos para leer quién estaba ahí
    </p>
    <Panoramica
      client:load
      slug={evento.slug}
      src={evento.panoramica}
      fotos={fotos}
      almas={evento.almas}
    />
  </section>

  <!-- ===================== MURO ===================== -->
  <section class="mx-auto max-w-6xl px-5 pb-20">
    <h2 class="stencil text-3xl text-hueso sm:text-4xl">LAS HISTORIAS</h2>
    <p class="cond mt-1 mb-6 text-xs uppercase tracking-ancho text-hueso-2/60">
      Lo que dejó cada uno de los que fue
    </p>
    <MuroHistorias
      client:load
      slug={evento.slug}
      fotos={fotos}
      almas={evento.almas}
    />
  </section>

  <!-- ===================== COMPARTIR ===================== -->
  <section class="mx-auto max-w-5xl px-5 pb-24 text-center">
    <hr class="divisor-pintado mb-10 mx-auto max-w-md" />
    <h2 class="stencil text-3xl text-hueso sm:text-4xl">LLEVALA A LA CALLE</h2>
    <p class="cond mt-1 mb-7 text-xs uppercase tracking-ancho text-hueso-2/60">
      Cuantos más sepan, más grande la multitud. Compartí esta misa.
    </p>
    <Compartir
      client:visible
      url={Astro.url.href}
      titulo={evento.titulo}
      almas={evento.almas}
      imagen={ogImagen}
      lugar={evento.lugar}
      ciudad={evento.ciudad}
      fecha={evento.fecha}
    />
  </section>

  <SubirModal
    client:load
    slug={evento.slug}
    panoramica={evento.panoramica}
    logueado={!!Astro.locals.user}
    fotoHabilitada={!!process.env.R2_BUCKET}
    usuarioAlias={Astro.locals.user?.alias || Astro.locals.user?.name || ''}
  />
</Base>
