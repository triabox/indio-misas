---
import Base from '@/layouts/Base.astro';
import AdminNav from '@/components/AdminNav.astro';
import EventoForm from '@/components/EventoForm.tsx';
import { getEventoAdmin } from '@/lib/admin.server';

const ev = await getEventoAdmin(Astro.params.id!);
if (!ev) return new Response(null, { status: 404, statusText: 'Misa no encontrada' });
---

<Base title={`Editar ${ev.titulo} — Admin`}>
  <section class="admin-wrap">
    <AdminNav />
    <a href="/admin/misas" class="cond text-xs uppercase tracking-ancho text-hueso-2/60 hover:text-sangre-viva">← Misas</a>
    <h1 class="stencil mt-4 text-4xl text-hueso titulo-sangre">EDITAR</h1>
    <p class="cond text-sm text-amarillo-luz/80">{ev.titulo}</p>
    <EventoForm client:load evento={ev} />
  </section>
</Base>
