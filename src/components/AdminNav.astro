---
const path = Astro.url.pathname;
const links: [string, string][] = [
  ['/admin', 'Panel'],
  ['/admin/misas', 'Misas'],
  ['/admin/importar', 'Importar'],
  ['/admin/posts', 'Moderación'],
  ['/admin/usuarios', 'Usuarios'],
];
const activo = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
---

<nav class="admin-nav">
  <span class="admin-nav-tag">ADMIN</span>
  {links.map(([href, label]) => (
    <a href={href} class={activo(href) ? 'on' : ''}>{label}</a>
  ))}
  <a href="/" class="admin-nav-salir">← al sitio</a>
</nav>
